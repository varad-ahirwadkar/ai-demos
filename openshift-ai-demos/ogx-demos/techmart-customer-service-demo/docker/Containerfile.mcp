# Containerfile for TechMart MCP Server
FROM registry.access.redhat.com/ubi9/python-312:latest

LABEL name="techmart-mcp-server" \
      version="1.0" \
      description="TechMart Orders MCP Server"

# Set working directory
WORKDIR /app

# Copy requirements first for better caching
COPY requirements.mcp.txt .

# Install dependencies
# Use the RH index as the primary source (required for Power/ppc64le builds where
# not all wheels are available on PyPI). PyPI is kept as fallback for packages the
# RH index does not carry.
# Note: the previous --extra-index= flag (missing -url) was silently ignored by pip.
RUN pip install --no-cache-dir \
      --index-url https://console.redhat.com/api/pypi/public-rhai/rhoai/3.5/cpu-ubi9/simple \
      --extra-index-url https://pypi.org/simple \
      -r requirements.mcp.txt

# Copy application files
COPY scripts/orders_mcp_server.py .
COPY data/orders.csv .

# Expose MCP server port
EXPOSE 9001

# Run the MCP server with python directly — avoids the fastmcp CLI which
# pulls in joserfc/cryptography and fails on python:3.12-slim due to an
# OpenSSL symbol mismatch (EVP_idea_ecb, version OPENSSL_3.0.0).
CMD ["python", "orders_mcp_server.py"]
