# Containerfile for pgvector on ppc64le / OpenShift
# Base: official postgres:17-bookworm (already contains PostgreSQL 17 binaries)
# Adds: pgvector 0.7.4 compiled from source
#
# Build with host networking so apt can reach the internet:
#   docker build --network host -f docker/Containerfile.pgvector -t quay.io/vahirwad/techmart:pgvector .
FROM postgres:17-bookworm

LABEL name="pgvector" \
      version="1.0" \
      description="PostgreSQL 17 + pgvector for ppc64le / OpenShift"

ARG PGVECTOR_VERSION=0.7.4

USER root

# Install build dependencies and pgvector in one layer.
# --network host is passed at build time (see build command above) so apt
# can reach deb.debian.org from the host's network interface.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        git \
        postgresql-server-dev-17 \
    && git clone --branch "v${PGVECTOR_VERSION}" --depth 1 \
        https://github.com/pgvector/pgvector.git /tmp/pgvector \
    && cd /tmp/pgvector \
    && make PG_CONFIG=/usr/lib/postgresql/17/bin/pg_config \
    && make install PG_CONFIG=/usr/lib/postgresql/17/bin/pg_config \
    && rm -rf /tmp/pgvector \
    && apt-get remove -y build-essential git postgresql-server-dev-17 \
    && apt-get autoremove -y \
    && rm -rf /var/lib/apt/lists/*

# Switch back to the unprivileged postgres user that the base image defines
USER postgres
