# TechMart Customer Service UI - Containerfile
FROM registry.access.redhat.com/ubi9/python-312:latest

USER root

# Set working directory
WORKDIR /app

# Copy requirements
COPY requirements.ui.txt .

# Install Python dependencies
# Use the RH index as the primary source (required for Power/ppc64le builds where
# not all wheels are available on PyPI). PyPI is kept as fallback for packages the
# RH index does not carry.
RUN pip install --no-cache-dir \
      --index-url https://console.redhat.com/api/pypi/public-rhai/rhoai/3.5/cpu-ubi9/simple \
      --extra-index-url https://pypi.org/simple \
      -r requirements.ui.txt

# Copy application files
COPY app/ /app/

# Create necessary directories
RUN mkdir -p /app/templates /app/static

# Set permissions
RUN chown -R 1001:0 /app && \
    chmod -R g=u /app

# Switch to non-root user
USER 1001

# Expose port
EXPOSE 8080

# Set environment variables
ENV FLASK_APP=app.py
ENV PYTHONUNBUFFERED=1

# Run with gunicorn — 2 workers prevent blocking on concurrent LLM requests
CMD ["gunicorn", "--workers", "2", "--bind", "0.0.0.0:8080", "--timeout", "660", "app:app"]
