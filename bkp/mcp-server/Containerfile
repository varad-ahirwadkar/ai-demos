FROM python:3.12-slim

LABEL maintainer="AI Demos Team"
LABEL description="Math Operations MCP Server for Llama Stack Integration"

# Set working directory
WORKDIR /app

# Install dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy server code
COPY server.py .

# Make server executable
RUN chmod +x server.py

# Expose MCP server port (configurable via PORT env var)
EXPOSE 9000

# Health check - check if server is responding on the SSE endpoint
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:9000/sse || exit 1

# Run the MCP server using fastmcp CLI
# This allows proper host binding (0.0.0.0) for container access
CMD ["fastmcp", "run", "server.py", "--transport", "sse", "--host", "0.0.0.0", "--port", "9000"]