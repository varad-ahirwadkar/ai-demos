# Containerfile for TechMart UI Application
FROM python:3.12-slim

LABEL name="techmart-ui-app" \
      version="1.0" \
      description="TechMart Customer Service UI Application"

# Set working directory
WORKDIR /app

# Copy requirements first for better caching
COPY requirements.txt .

# Install dependencies
RUN pip install --no-cache-dir -r requirements.txt

# Copy application files
COPY src/app.py .
COPY data/return-policy.txt .
COPY src/templates/ templates/

# Expose Flask port
EXPOSE 8000

# Set environment variables
ENV PYTHONUNBUFFERED=1 \
    PORT=8000 \
    LLAMA_STACK_URL=http://llama-stack:5001 \
    MCP_SERVER_URL=http://mcp-server:9001/sse

# Run the Flask application
CMD ["python", "app.py"]